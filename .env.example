# --- Telegram API ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_USER_IDS=12345678,98765432
# URL торгового движка для HTTP из контейнера бота (по умолчанию localhost):
# TELEGRAM_ENGINE_URL=http://trading-engine:8000
# Inline-меню: пресеты плеча (1..125), лимит сигналов в разделе «Сигналы», доли частичного закрытия позиции (%):
# TELEGRAM_LEVERAGE_PRESETS=5,10,15,20,25,50
# TELEGRAM_SIGNALS_PREVIEW_LIMIT=5
# TELEGRAM_POSITION_REDUCE_PCTS=25,50

# --- Binance API (Real) ---
API_KEY_BINANCE=your_api_key_here
SECRET_API_KEY_BINANCE=your_secret_key_here

# --- Binance API (Testnet) ---
TEST_API_KEY_BINANCE=your_testnet_api_key_here
TEST_SECRET_API_KEY_BINANCE=your_testnet_secret_key_here

# --- Docker build (optional) ---
# If `docker compose build` fails with TLS timeout to registry-1.docker.io, either:
# - use VPN / stable network and retry `docker pull python:3.11-slim`, then build; or
# - set a reachable mirror / full image ref (examples depend on your region):
# DOCKER_PYTHON_IMAGE=python:3.11-slim-bookworm

# --- Database & Redis ---
DATABASE_URL=postgresql+asyncpg://quant_user:quant_password@postgres:5432/quant_db
REDIS_URL=redis://redis:6379
# Runtime REST: GET /api/v1/runtime-settings includes integer `config_schema_version` (see config/schema_version.py).
# POST /api/v1/runtime-settings/* persists a JSON snapshot to table `runtime_engine_settings` (Alembic revision
# 20260512_engine_runtime_settings) so multiple engine instances converge after restart once migrations are applied.

# PostgreSQL Internal (Docker)
POSTGRES_USER=quant_user
POSTGRES_PASSWORD=quant_password
POSTGRES_DB=quant_db

# --- Trading Mode ---
TESTNET=True
IS_TRADING_ENABLED=True
# Optional: regime router (ADX trend vs range); defaults match config/settings.py
# STRATEGY_REGIME_ROUTING_ENABLED=True
# REGIME_ADX_TREND_MIN=22
# REGIME_ADX_RANGE_MAX=18

# --- Signal loop circuit breaker (optional; defaults in config/settings.py) ---
# ERROR_WINDOW_SECONDS=600
# ERROR_THRESHOLD=10

# --- Execution: post-only GTX limit entries on Binance (optional) ---
# USE_POST_ONLY=False

# --- Market universe (single source of truth; D1) ---
# The trading API (`api/rest/main.py`) and `services/market_data/worker.py` both read
# `settings.market_symbols` / `settings.market_timeframes` from this file (or defaults in
# `config/settings.py`). Use the **same** `MARKET_*` values in every deployment unit so the
# worker does not publish streams for pairs the engine never subscribes to (wasted load and
# confusing logs). Comma-separated; symbols in ccxt form, e.g. `BTC/USDT`.
# MARKET_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
# Include `1w` (and `1d` if needed) so weekly/daily MTF logic in the signal engine is actually
# fed candles; omitting `1w` effectively disables `_get_weekly_trend_bias` for that stream.
# MARKET_TIMEFRAMES=1m,5m,15m,1h,4h,1d,1w
#
# Redis `market:data` messages: field `ts` is the event-loop monotonic clock; for wall-clock
# audit (latency, cross-service correlation) use `wall_ts` / `wall_ts_iso` in the payload (D4).

# --- Market streamer: OHLCV WebSocket vs REST mode (D3) ---
# When `MARKET_STREAMER_FORCE_PROD_CHART_WS=True` (default): candle/chart WebSocket uses
# Binance **production** `fstream`, while `TESTNET=True` keeps REST and **orders** on futures
# testnet — i.e. two different markets. Treat that combo as **sanity / plumbing checks only**,
# not as a faithful simulation of production prices. For aligned testnet candles + testnet
# execution, set `MARKET_STREAMER_FORCE_PROD_CHART_WS=False` so WS URLs follow the exchange
# mode used for REST.
# MARKET_STREAMER_FORCE_PROD_CHART_WS=True

# --- Security ---
ENCRYPTION_KEY=your_encryption_key_here

# ====================================================================
# EXTERNAL AI PROVIDERS — cascade fallback
# ====================================================================
# Order of providers to try (first = primary, rest = fallback)
AI_CASCADE_ORDER=groq,grok,gemini,openrouter

# Groq (free: 30 RPM, Llama 3.3 70B)
GROQ_API_KEY=your_groq_key
GROQ_MODEL=llama-3.3-70b-versatile

# xAI / Grok ($25/mo free credit)
GROK_API_KEY=your_grok_key
GROK_API_URL=https://api.x.ai
GROK_MODEL=grok-3-mini

# Google Gemini (free: 15 RPM)
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter (free models available)
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
